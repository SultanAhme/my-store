# ===============================================
# .gitignore: ملفات ما نبي git يرفعها لـ GitHub
# ===============================================

# مجلد الأدوات اللي نزلناها بـ npm (مثل express)
# كبير جداً، وأي أحد يقدر يرجعه بأمر npm install
node_modules/

# قاعدة البيانات: فيها حسابات الزبائن وطلباتهم
# بيانات خاصة، ما تنرفع لمستودع عام أبداً
*.db